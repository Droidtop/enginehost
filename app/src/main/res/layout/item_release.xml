<?xml version="1.0" encoding="utf-8"?>
<!--
    One plugin in the store: what it runs, its channel when that is not
    Stable, the engine versions it ships, and one button. Download progress
    shows in the button and the bar beneath it, on the card itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/eh_space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/releaseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <TextView
            android:id="@+id/releaseStream"
            style="@style/Widget.Enginehost.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:visibility="gone" />

        <TextView
            android:id="@+id/releaseVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.Mono"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/releaseCompatibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_xs"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/releaseIncludes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/releaseActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:orientation="vertical" />

    <ProgressBar
        android:id="@+id/releaseProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_xs"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/releaseOlderToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/eh_touch_target"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption"
        android:textColor="@color/eh_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/releaseOlderList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/releaseMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_xs"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

</LinearLayout>
