<?xml version="1.0" encoding="utf-8"?>
<!--
    One pending update in the Plugins screen's Updates section: what the
    new build is and where it comes from, and the one action, installing
    it. Whether the install then needs a decision is trust carry-over's
    to say (same origin and key: nothing further; anything else: the
    one-plugin decision screen).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/eh_space_s"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <Button
            android:id="@+id/updateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s" />

    </LinearLayout>

    <TextView
        android:id="@+id/updateMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

</LinearLayout>
