<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings as rows: each says what it is and what it is set to, and a tap
    offers the choices. Three groups: where saves go, how updates arrive,
    and the app itself.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:layout_marginStart="12dp"
            android:text="@string/save_location"
            android:textAppearance="@style/TextAppearance.Enginehost.SectionTitle" />

        <LinearLayout
            style="@style/Widget.Enginehost.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/saveRootRow"
                style="@style/Widget.Enginehost.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_save_folder"
                        android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                    <TextView
                        android:id="@+id/saveLocationValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/eh_icon"
                    android:layout_height="@dimen/eh_icon"
                    android:layout_marginStart="@dimen/eh_space_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/eh_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/engineSaveRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/engineSaveEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:text="@string/engine_save_none_installed"
                android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

            <LinearLayout
                android:id="@+id/browserStartRow"
                style="@style/Widget.Enginehost.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/browser_start"
                        android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                    <TextView
                        android:id="@+id/browserStartValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/eh_icon"
                    android:layout_height="@dimen/eh_icon"
                    android:layout_marginStart="@dimen/eh_space_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/eh_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:layout_marginStart="12dp"
            android:text="@string/updates_section"
            android:textAppearance="@style/TextAppearance.Enginehost.SectionTitle" />

        <LinearLayout
            style="@style/Widget.Enginehost.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/updateFrequencyRow"
                style="@style/Widget.Enginehost.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/updates_frequency_label"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                <TextView
                    android:id="@+id/updateFrequencyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

                <ImageView
                    android:layout_width="@dimen/eh_icon"
                    android:layout_height="@dimen/eh_icon"
                    android:layout_marginStart="@dimen/eh_space_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/eh_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pluginStreamRow"
                style="@style/Widget.Enginehost.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/updates_stream_label"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                <TextView
                    android:id="@+id/pluginStreamValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

                <ImageView
                    android:layout_width="@dimen/eh_icon"
                    android:layout_height="@dimen/eh_icon"
                    android:layout_marginStart="@dimen/eh_space_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/eh_text_secondary" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/unmeteredOnlySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/eh_row_height"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/updates_unmetered_only"
                android:textAppearance="@style/TextAppearance.Enginehost.Body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoInstallPluginsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/eh_row_height"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="@string/updates_install_plugins_automatically"
                android:textAppearance="@style/TextAppearance.Enginehost.Body" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:layout_marginStart="12dp"
            android:text="@string/settings_about"
            android:textAppearance="@style/TextAppearance.Enginehost.SectionTitle" />

        <LinearLayout
            style="@style/Widget.Enginehost.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/appVersionRow"
                style="@style/Widget.Enginehost.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/appVersionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                    <TextView
                        android:id="@+id/lastCheckedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/eh_icon"
                    android:layout_height="@dimen/eh_icon"
                    android:layout_marginStart="@dimen/eh_space_s"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/eh_accent" />

            </LinearLayout>

            <Button
                android:id="@+id/installAppUpdateButton"
                style="@style/Widget.Enginehost.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/eh_space_s"
                android:text="@string/app_update_install"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
