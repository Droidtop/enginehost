<?xml version="1.0" encoding="utf-8"?>
<!--
    One game in a library list: its name, one line of state (builds, what
    this device can do with it, size), the engine as a coloured chip, and a
    chevron, or a word on the right when the row is acting on a choice (the
    scan's Add). The row itself is not a focus target: the list selects it,
    and the selection draws the same ring a focused card does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eh_card_selectable_bg"
    android:gravity="center_vertical"
    android:minHeight="@dimen/eh_touch_target"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <TextView
            android:id="@+id/gameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    </LinearLayout>

    <TextView
        android:id="@+id/gameEngine"
        style="@style/Widget.Enginehost.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/eh_space_s"
        android:ellipsize="end"
        android:maxWidth="160dp" />

    <TextView
        android:id="@+id/gameMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/eh_space_s"
        android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
        android:textColor="@color/eh_accent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/gameChevron"
        android:layout_width="@dimen/eh_icon"
        android:layout_height="@dimen/eh_icon"
        android:layout_marginStart="@dimen/eh_space_s"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron"
        android:tint="@color/eh_text_secondary" />

</LinearLayout>
