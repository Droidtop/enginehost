<?xml version="1.0" encoding="utf-8"?>
<!--
    One installed plugin: what it runs, its provenance badge, its build and
    source on one line, and the decision. The identifiers a security review
    wants (bundle id, verified origin, signer fingerprint) are one tap away
    under Details rather than in everyone's face.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/eh_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pluginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <TextView
            android:id="@+id/trustBadge"
            style="@style/Widget.Enginehost.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s" />

    </LinearLayout>

    <TextView
        android:id="@+id/trustBuildLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/trustState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/trustDetailsToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/eh_touch_target"
        android:gravity="center_vertical"
        android:text="@string/details"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption"
        android:textColor="@color/eh_accent" />

    <LinearLayout
        android:id="@+id/trustDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/bundleId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Enginehost.Mono" />

        <TextView
            android:id="@+id/originValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

        <TextView
            android:id="@+id/signerValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Enginehost.Mono" />

    </LinearLayout>

    <TextView
        android:id="@+id/trustWarning"
        style="@style/Widget.Enginehost.Warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_m"
        android:text="@string/ultimate_warning"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:orientation="horizontal">

        <Button
            android:id="@+id/approveButton"
            style="@style/Widget.Enginehost.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/approve" />

        <Button
            android:id="@+id/denyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:layout_weight="1"
            android:text="@string/deny" />

        <Button
            android:id="@+id/uninstallButton"
            style="@style/Widget.Enginehost.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:layout_weight="1"
            android:text="@string/uninstall" />

    </LinearLayout>

</LinearLayout>
