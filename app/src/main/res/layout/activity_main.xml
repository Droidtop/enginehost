<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. The library is the screen; everything else is four small
    destinations at the bottom. No explanatory copy: the game cards say what
    state each game is in, and a destination's name is its description.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:id="@+id/updateNotice"
            style="@style/Widget.Enginehost.Card.Focusable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
            android:textColor="@color/eh_accent" />

        <EditText
            android:id="@+id/gameSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:hint="@string/search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/gameLibraryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickAndLaunchButton"
                style="@style/Widget.Enginehost.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_game_folder" />

            <Button
                android:id="@+id/scanFolderButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eh_space_s"
                android:layout_weight="1"
                android:text="@string/scan_folder" />

        </LinearLayout>

        <!-- Destinations: two rows of two. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pluginCatalogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/browse_plugins" />

            <Button
                android:id="@+id/controllerConfigButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eh_space_s"
                android:layout_weight="1"
                android:text="@string/controller_settings" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/enginehostSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enginehost_settings" />

            <Button
                android:id="@+id/createConfigButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eh_space_s"
                android:layout_weight="1"
                android:text="@string/open_config_creator" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
