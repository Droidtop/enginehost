<?xml version="1.0" encoding="utf-8"?>
<!--
    Home, the Library destination. The library is the screen: a filterable
    list that scrolls on its own, with the one way to add games in the header.
    The other destinations are the bar or rail the activity draws around this
    ([DestinationBar]), so one layout serves every window; the grid fits its
    columns to the width it gets. No explanatory copy: the game cards say what
    state each game is in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/eh_screen_padding_h"
    android:paddingRight="@dimen/eh_screen_padding_h"
    android:paddingTop="@dimen/eh_screen_padding_v"
    android:paddingBottom="@dimen/eh_screen_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <Button
            android:id="@+id/addGamesButton"
            style="@style/Widget.Enginehost.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_add"
            android:text="@string/add_games" />

    </LinearLayout>

    <TextView
        android:id="@+id/updateNotice"
        style="@style/Widget.Enginehost.Card.Focusable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
        android:textColor="@color/eh_accent"
        android:visibility="gone" />

    <include
        layout="@layout/view_library_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_m" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/eh_space_s"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gameGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fastScrollEnabled="true"
            android:horizontalSpacing="@dimen/eh_column_gap"
            android:listSelector="@android:color/transparent"
            android:nextFocusUp="@id/gameGrid"
            android:numColumns="1"
            android:scrollbars="vertical"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/eh_space_s" />

        <TextView
            android:id="@+id/gameEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.Body"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
