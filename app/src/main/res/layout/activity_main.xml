<?xml version="1.0" encoding="utf-8"?>
<!--
    Home. The library is the screen; beneath it two library actions and
    four destinations, each an icon and a name. No explanatory copy: the game
    cards say what state each game is in.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:id="@+id/updateNotice"
            style="@style/Widget.Enginehost.Card.Focusable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
            android:textColor="@color/eh_accent"
            android:visibility="gone" />

        <EditText
            android:id="@+id/gameSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:hint="@string/search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/gameLibraryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickAndLaunchButton"
                style="@style/Widget.Enginehost.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/add_game_folder" />

            <Button
                android:id="@+id/scanFolderButton"
                style="@style/Widget.Enginehost.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eh_space_s"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_scan"
                android:text="@string/scan_folder" />

        </LinearLayout>

        <Button
            android:id="@+id/pluginCatalogButton"
            style="@style/Widget.Enginehost.Button.Nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:drawableStart="@drawable/ic_plugins"
            android:text="@string/browse_plugins" />

        <Button
            android:id="@+id/controllerConfigButton"
            style="@style/Widget.Enginehost.Button.Nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:drawableStart="@drawable/ic_controller"
            android:text="@string/controller_settings" />

        <Button
            android:id="@+id/enginehostSettingsButton"
            style="@style/Widget.Enginehost.Button.Nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/enginehost_settings" />

        <Button
            android:id="@+id/createConfigButton"
            style="@style/Widget.Enginehost.Button.Nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:drawableStart="@drawable/ic_setup"
            android:text="@string/open_config_creator" />

    </LinearLayout>
</ScrollView>
