<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Config creator"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose the game folder. Existing settings are loaded and unknown fields are preserved." />

        <Button
            android:id="@+id/chooseConfigFolderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose game folder" />

        <TextView
            android:id="@+id/configFolderLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No folder selected"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/detectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Engine detection starts after a folder is selected." />

        <Button
            android:id="@+id/browseAllPluginsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose from all plugin engines"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/editorFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/engineField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Engine family (required), e.g. rpgmaker"
                android:inputType="text" />

            <EditText
                android:id="@+id/engineContextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Engine context, e.g. vxace"
                android:inputType="text" />

            <EditText
                android:id="@+id/engineVersionField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Engine version (required), e.g. 3.0"
                android:inputType="text" />

            <EditText
                android:id="@+id/runtimeRequirementsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Embedded runtimes JSON, e.g. {&quot;ruby&quot;:&quot;1.9.2&quot;}"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="2" />

            <EditText
                android:id="@+id/pluginVersionField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Allowed plugin versions (optional)"
                android:inputType="text" />

            <EditText
                android:id="@+id/execFileField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Entry file inside the folder (optional)"
                android:inputType="text" />

            <EditText
                android:id="@+id/optionsField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Engine options JSON"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4" />

            <Button
                android:id="@+id/saveConfigButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Save enginehost.json" />

            <Button
                android:id="@+id/testConfigButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test this configuration" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
