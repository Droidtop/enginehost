<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/eh_touch_target"
                android:layout_height="@dimen/eh_touch_target"
                android:layout_marginEnd="@dimen/eh_space_xs"
                android:background="@drawable/eh_row_bg"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/eh_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan_title"
                android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

            <Button
                android:id="@+id/chooseScanFolderButton"
                style="@style/Widget.Enginehost.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_folder"
                android:text="@string/scan_choose" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_xs"
            android:text="@string/scan_intro"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

        <TextView
            android:id="@+id/scanRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:background="@drawable/eh_card_bg"
            android:padding="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.Mono"
            android:visibility="gone" />

        <TextView
            android:id="@+id/scanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.Body"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addAllButton"
                style="@style/Widget.Enginehost.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan_add_all"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelScanButton"
                style="@style/Widget.Enginehost.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eh_space_s"
                android:text="@string/scan_cancel"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
