<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/eh_touch_target"
                android:layout_height="@dimen/eh_touch_target"
                android:layout_marginEnd="@dimen/eh_space_xs"
                android:background="@drawable/eh_row_bg"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/eh_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/controller_settings"
                android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        </LinearLayout>

        <TextView
            android:id="@+id/connectedControllers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_xs"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_l"
            android:text="@string/applies_to"
            android:textAppearance="@style/TextAppearance.Enginehost.SectionTitle" />

        <LinearLayout
            android:id="@+id/scopeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/scopeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:textAppearance="@style/TextAppearance.Enginehost.Body" />

        <LinearLayout
            android:id="@+id/bindingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_s"
            android:orientation="vertical" />

        <Button
            android:id="@+id/resetButton"
            style="@style/Widget.Enginehost.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m" />

    </LinearLayout>
</ScrollView>
