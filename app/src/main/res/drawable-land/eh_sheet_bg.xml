<?xml version="1.0" encoding="utf-8"?>
<!--
    In landscape a sheet stands on the right edge: its left corners are
    round, and its 1 dp edge line is on the left, facing the content.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_outline" />
            <corners
                android:bottomLeftRadius="@dimen/eh_corner"
                android:topLeftRadius="@dimen/eh_corner" />
        </shape>
    </item>
    <item android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface_sheet" />
            <corners
                android:bottomLeftRadius="@dimen/eh_corner"
                android:topLeftRadius="@dimen/eh_corner" />
        </shape>
    </item>
</layer-list>
