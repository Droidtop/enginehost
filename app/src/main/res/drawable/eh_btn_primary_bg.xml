<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface_variant" />
            <corners android:radius="@dimen/eh_corner_small" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_accent_pressed" />
            <corners android:radius="@dimen/eh_corner_small" />
        </shape>
    </item>
    <!--
        Focus on a filled button: the same ring as everywhere else, drawn
        outside the fill with a gap of ground between, since an accent ring
        on an accent fill would not show; the fill itself is raised.
    -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="@dimen/eh_focus_stroke"
                        android:color="@color/eh_focus_ring" />
                    <corners android:radius="@dimen/eh_corner_small" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/eh_accent_pressed" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_accent" />
            <corners android:radius="@dimen/eh_corner_small" />
        </shape>
    </item>
</selector>
