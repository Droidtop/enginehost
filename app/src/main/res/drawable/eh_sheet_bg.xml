<?xml version="1.0" encoding="utf-8"?>
<!--
    A sheet held upright rises from the bottom edge: its top corners are
    round. Level 2 of the surfaces (#644 proposal 4.1): the sheet ground,
    with a 1 dp line on the edge that faces the content.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_outline" />
            <corners
                android:topLeftRadius="@dimen/eh_corner"
                android:topRightRadius="@dimen/eh_corner" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface_sheet" />
            <corners
                android:topLeftRadius="@dimen/eh_corner"
                android:topRightRadius="@dimen/eh_corner" />
        </shape>
    </item>
</layer-list>
