<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface_variant" />
            <stroke android:width="1dp" android:color="@color/eh_accent" />
            <corners android:radius="@dimen/eh_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface_variant" />
            <stroke android:width="@dimen/eh_focus_stroke" android:color="@color/eh_accent" />
            <corners android:radius="@dimen/eh_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eh_surface" />
            <stroke android:width="1dp" android:color="@color/eh_outline" />
            <corners android:radius="@dimen/eh_corner" />
        </shape>
    </item>
</selector>
