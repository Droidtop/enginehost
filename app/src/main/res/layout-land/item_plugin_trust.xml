<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape trust card. Two per row, which on this screen still leaves each
    card wider than a portrait phone, so nothing here is compressed: the badge,
    the full signer fingerprint and the Ultimate warning keep the room they had.
    The card padding is pinned back to the full spacing scale rather than the
    landscape density tokens, because this is a security surface, not a list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_gravity="fill_horizontal"
    android:padding="@dimen/eh_space_m"
    android:layout_marginEnd="@dimen/eh_column_gap"
    android:layout_marginBottom="@dimen/eh_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pluginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <TextView
            android:id="@+id/trustBadge"
            style="@style/Widget.Enginehost.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s" />

    </LinearLayout>

    <TextView
        android:id="@+id/bundleId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_xs"
        android:textAppearance="@style/TextAppearance.Enginehost.Mono" />

    <TextView
        android:id="@+id/originValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/signerValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/trustState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/trustWarning"
        style="@style/Widget.Enginehost.Warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_m"
        android:text="@string/ultimate_warning"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:orientation="horizontal">

        <Button
            android:id="@+id/approveButton"
            style="@style/Widget.Enginehost.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/approve" />

        <Button
            android:id="@+id/denyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:layout_weight="1"
            android:text="@string/deny" />

        <Button
            android:id="@+id/uninstallButton"
            style="@style/Widget.Enginehost.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eh_space_s"
            android:layout_weight="1"
            android:text="@string/uninstall" />

    </LinearLayout>

</LinearLayout>
