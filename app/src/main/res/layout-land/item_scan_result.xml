<?xml version="1.0" encoding="utf-8"?>
<!-- Scan result card sized for one weighted column of the landscape grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_gravity="fill_horizontal"
    android:layout_marginEnd="@dimen/eh_column_gap"
    android:layout_marginBottom="@dimen/eh_space_s">

    <TextView
        android:id="@+id/scanResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

    <TextView
        android:id="@+id/scanResultDetection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    <TextView
        android:id="@+id/scanResultPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="start"
        android:textAppearance="@style/TextAppearance.Enginehost.Mono" />

    <TextView
        android:id="@+id/scanResultNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_xs"
        android:textAppearance="@style/TextAppearance.Enginehost.Caption"
        android:textColor="@color/eh_caution"
        android:visibility="gone" />

    <Button
        android:id="@+id/scanResultAdd"
        style="@style/Widget.Enginehost.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eh_space_s"
        android:minWidth="120dp"
        android:text="@string/scan_add" />

</LinearLayout>
