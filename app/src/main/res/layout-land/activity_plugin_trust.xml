<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape plugin trust. Two cards per row rather than one full width card,
    which still leaves each card wider than a portrait phone screen, so the
    density gain here costs the security surface nothing: badge, fingerprint
    and Ultimate warning all keep their portrait treatment.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/eh_screen_padding_h"
        android:paddingRight="@dimen/eh_screen_padding_h"
        android:paddingTop="@dimen/eh_screen_padding_v"
        android:paddingBottom="@dimen/eh_screen_padding_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/eh_touch_target"
                android:layout_height="@dimen/eh_touch_target"
                android:layout_marginEnd="@dimen/eh_space_xs"
                android:background="@drawable/eh_row_bg"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/eh_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/trust_title"
                android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_xs"
            android:text="@string/trust_intro"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

        <GridLayout
            android:id="@+id/pluginList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:columnCount="2"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:text="@string/trust_empty"
            android:textAppearance="@style/TextAppearance.Enginehost.Body"
            android:visibility="gone" />

        <Button
            android:id="@+id/openCatalogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eh_space_m"
            android:text="@string/open_plugin_catalog"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
