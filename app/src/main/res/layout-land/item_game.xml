<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape library card, sized for one weighted column of the two column
    GridLayout that replaces the list, so a 1920px wide screen shows two
    games per row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Enginehost.Card.Focusable"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_gravity="fill_horizontal"
    android:layout_marginEnd="@dimen/eh_column_gap"
    android:layout_marginBottom="@dimen/eh_space_s"
    android:gravity="center_vertical"
    android:minHeight="@dimen/eh_touch_target"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

        <TextView
            android:id="@+id/gamePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Enginehost.Mono"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gameStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/gameEngine"
        style="@style/Widget.Enginehost.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/eh_space_s"
        android:visibility="gone" />

    <ImageView
        android:layout_width="@dimen/eh_icon"
        android:layout_height="@dimen/eh_icon"
        android:layout_marginStart="@dimen/eh_space_s"
        android:contentDescription="@null"
        android:src="@drawable/ic_play"
        android:tint="@color/eh_accent" />

</LinearLayout>
