<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape controller profile. The wizard prompt and the buttons that
    drive it belong together on the left; the list of what this pad sends
    is long and gets its own scrolling column, so a capture in progress
    never pushes the next prompt off the bottom of the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/eh_screen_padding_h"
    android:paddingRight="@dimen/eh_screen_padding_h"
    android:paddingTop="@dimen/eh_screen_padding_v"
    android:paddingBottom="@dimen/eh_screen_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/eh_touch_target"
            android:layout_height="@dimen/eh_touch_target"
            android:layout_marginEnd="@dimen/eh_space_xs"
            android:background="@drawable/eh_row_bg"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_back"
            android:tint="@color/eh_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/controller_profile"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:id="@+id/profileDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_space_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Enginehost.Caption" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/eh_space_s"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                <TextView
                    android:id="@+id/profileHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body" />

                <Button
                    android:id="@+id/captureButton"
                    style="@style/Widget.Enginehost.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_m" />

                <Button
                    android:id="@+id/clearButton"
                    style="@style/Widget.Enginehost.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_xs" />

                <Button
                    android:id="@+id/bypassProfileButton"
                    style="@style/Widget.Enginehost.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_xs" />

            </LinearLayout>

        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_column_gap"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/profileList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
