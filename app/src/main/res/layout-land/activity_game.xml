<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape game screen: what the game is and its cover plate fill the
    left pane (the same split as Home's library), its actions sit in a
    sidebar on the right. The plate takes all the height the header leaves
    free, so the freed space is content, never flat background.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/eh_screen_padding_h"
    android:paddingRight="@dimen/eh_screen_padding_h"
    android:paddingTop="@dimen/eh_screen_padding_v"
    android:paddingBottom="@dimen/eh_screen_padding_v">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/eh_touch_target"
                    android:layout_height="@dimen/eh_touch_target"
                    android:layout_marginEnd="@dimen/eh_space_xs"
                    android:background="@drawable/eh_row_bg"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/eh_text_primary" />

                <TextView
                    android:id="@+id/gameTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eh_space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gameEngine"
                    style="@style/Widget.Enginehost.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/eh_space_s"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/gameStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body" />

            </LinearLayout>

            <TextView
                android:id="@+id/gamePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eh_space_s"
                android:textAppearance="@style/TextAppearance.Enginehost.Mono"
                android:textIsSelectable="false" />

            <!--
                The cover plate, the pane's content region: the game's own
                art when it has any, otherwise the same plate with its
                name and engine line -- never a stand-in cover. It takes
                all the height the header leaves free; a window too short
                for that scrolls instead (eh_plate_min).
            -->
            <FrameLayout
                android:id="@+id/gamePlate"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/eh_space_m"
                android:layout_weight="1"
                android:background="@drawable/eh_card_bg"
                android:minHeight="@dimen/eh_plate_min">

                <ImageView
                    android:id="@+id/plateArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/eh_space_m"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/platePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/eh_space_l">

                    <TextView
                        android:id="@+id/plateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle" />

                    <TextView
                        android:id="@+id/plateLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eh_space_s"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Enginehost.Body"
                        android:textColor="@color/eh_text_secondary"
                        android:visibility="gone" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/eh_column_gap"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/playButton"
                style="@style/Widget.Enginehost.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_play"
                android:text="@string/action_launch" />

            <Button
                android:id="@+id/setupButton"
                style="@style/Widget.Enginehost.Button.Nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eh_space_l"
                android:drawableStart="@drawable/ic_setup"
                android:text="@string/action_edit_config" />

            <Button
                android:id="@+id/reportButton"
                style="@style/Widget.Enginehost.Button.Nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eh_space_s"
                android:drawableStart="@drawable/ic_report"
                android:text="@string/action_report" />

            <Button
                android:id="@+id/removeButton"
                style="@style/Widget.Enginehost.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eh_space_s"
                android:text="@string/action_remove" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
