<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape home. The library takes two thirds of the width as a two
    column grid that scrolls on its own; the one way to add games and the
    three destinations sit in a sidebar beside it, each an icon and a name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/eh_screen_padding_h"
    android:paddingRight="@dimen/eh_screen_padding_h"
    android:paddingTop="@dimen/eh_screen_padding_v"
    android:paddingBottom="@dimen/eh_screen_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:id="@+id/updateNotice"
            style="@style/Widget.Enginehost.Card.Focusable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_space_m"
            android:paddingTop="@dimen/eh_space_s"
            android:paddingBottom="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
            android:textColor="@color/eh_accent"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/eh_space_s"
        android:orientation="horizontal">

        <!-- Library pane. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <include
                layout="@layout/view_library_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/eh_space_xs"
                android:layout_weight="1">

                <GridView
                    android:id="@+id/gameGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fastScrollEnabled="true"
                    android:horizontalSpacing="@dimen/eh_column_gap"
                    android:listSelector="@android:color/transparent"
                    android:nextFocusUp="@id/gameGrid"
                    android:numColumns="2"
                    android:scrollbars="vertical"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="@dimen/eh_space_s" />

                <TextView
                    android:id="@+id/gameEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/eh_space_s"
                    android:textAppearance="@style/TextAppearance.Enginehost.Body"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Sidebar. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_column_gap"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/addGamesButton"
                    style="@style/Widget.Enginehost.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:text="@string/add_games" />

                <Button
                    android:id="@+id/pluginCatalogButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_l"
                    android:drawableStart="@drawable/ic_plugins"
                    android:text="@string/browse_plugins" />

                <Button
                    android:id="@+id/controllerConfigButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_controller"
                    android:text="@string/controller_settings" />

                <Button
                    android:id="@+id/enginehostSettingsButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_settings"
                    android:text="@string/enginehost_settings" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
