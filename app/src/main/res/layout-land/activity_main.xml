<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape home. The library takes two thirds of the width as a two
    column grid that scrolls on its own; the two library actions and the
    four destinations sit in a sidebar beside it, each an icon and a name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/eh_screen_padding_h"
    android:paddingRight="@dimen/eh_screen_padding_h"
    android:paddingTop="@dimen/eh_screen_padding_v"
    android:paddingBottom="@dimen/eh_screen_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Enginehost.ScreenTitle" />

        <TextView
            android:id="@+id/updateNotice"
            style="@style/Widget.Enginehost.Card.Focusable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_space_m"
            android:paddingTop="@dimen/eh_space_s"
            android:paddingBottom="@dimen/eh_space_s"
            android:textAppearance="@style/TextAppearance.Enginehost.ItemTitle"
            android:textColor="@color/eh_accent"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/eh_space_s"
        android:orientation="horizontal">

        <!-- Library pane. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <EditText
                android:id="@+id/gameSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/eh_space_xs"
                android:scrollbars="none">

                <GridLayout
                    android:id="@+id/gameLibraryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:orientation="horizontal" />

            </ScrollView>

        </LinearLayout>

        <!-- Sidebar. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eh_column_gap"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/pickAndLaunchButton"
                    style="@style/Widget.Enginehost.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_add"
                    android:text="@string/add_game_folder" />

                <Button
                    android:id="@+id/scanFolderButton"
                    style="@style/Widget.Enginehost.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_scan"
                    android:text="@string/scan_folder" />

                <Button
                    android:id="@+id/pluginCatalogButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_l"
                    android:drawableStart="@drawable/ic_plugins"
                    android:text="@string/browse_plugins" />

                <Button
                    android:id="@+id/controllerConfigButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_controller"
                    android:text="@string/controller_settings" />

                <Button
                    android:id="@+id/enginehostSettingsButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_settings"
                    android:text="@string/enginehost_settings" />

                <Button
                    android:id="@+id/createConfigButton"
                    style="@style/Widget.Enginehost.Button.Nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eh_space_s"
                    android:drawableStart="@drawable/ic_setup"
                    android:text="@string/open_config_creator" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
