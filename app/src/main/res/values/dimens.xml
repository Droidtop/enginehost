<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="eh_space_xs">4dp</dimen>
    <dimen name="eh_space_s">8dp</dimen>
    <dimen name="eh_space_m">16dp</dimen>
    <dimen name="eh_space_l">24dp</dimen>
    <dimen name="eh_corner">16dp</dimen>
    <dimen name="eh_corner_small">10dp</dimen>
    <dimen name="eh_touch_target">48dp</dimen>
    <dimen name="eh_focus_stroke">3dp</dimen>
    <dimen name="eh_icon">22dp</dimen>
    <dimen name="eh_row_height">56dp</dimen>

    <!--
        Density tokens. Portrait runs out of width, landscape runs out of
        height, so the horizontal and vertical halves are separate tokens and
        values-land tightens only the vertical ones. Screens and cards read
        these instead of the raw spacing scale, so one override retunes both.
    -->
    <dimen name="eh_screen_padding_h">20dp</dimen>
    <dimen name="eh_screen_padding_v">16dp</dimen>
    <dimen name="eh_card_padding_h">16dp</dimen>
    <dimen name="eh_card_padding_v">14dp</dimen>

    <!-- The narrowest a game card in the library grid is drawn; the grid fits as many columns as that allows. -->
    <dimen name="eh_card_min_width">320dp</dimen>
    <!-- A game on a Home shelf. -->
    <dimen name="eh_shelf_card_width">200dp</dimen>
    <!-- One destination in the left rail: wide enough for its label. -->
    <dimen name="eh_rail_item_width">80dp</dimen>
    <!-- Gap between side by side panes and between grid columns. -->
    <dimen name="eh_column_gap">16dp</dimen>
    <!-- A landscape sheet's width: a share of the window, never narrower or wider than these. -->
    <dimen name="eh_sheet_min_width">320dp</dimen>
    <dimen name="eh_sheet_max_width">480dp</dimen>
    <dimen name="eh_launch_icon">112dp</dimen>
    <dimen name="eh_launch_title_text">26sp</dimen>
    <!--
        The cover plate's floor on a game's own screen. The plate fills
        whatever the header and actions leave free; on a window too short
        for that it stays this tall and the screen scrolls, because a plate
        that collapses to nothing turns back into the empty gap it replaced.
    -->
    <dimen name="eh_plate_min">128dp</dimen>
</resources>
