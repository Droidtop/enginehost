<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography -->

    <style name="TextAppearance.Enginehost.ScreenTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eh_text_primary</item>
    </style>

    <style name="TextAppearance.Enginehost.SectionTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eh_text_primary</item>
    </style>

    <style name="TextAppearance.Enginehost.ItemTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eh_text_primary</item>
    </style>

    <style name="TextAppearance.Enginehost.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/eh_text_primary</item>
    </style>

    <style name="TextAppearance.Enginehost.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/eh_text_secondary</item>
    </style>

    <style name="TextAppearance.Enginehost.Mono" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">@color/eh_text_secondary</item>
    </style>

    <!-- Widgets -->

    <style name="Widget.Enginehost.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/eh_btn_primary_bg</item>
        <item name="android:textColor">@color/eh_button_primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/eh_touch_target</item>
        <item name="android:paddingLeft">@dimen/eh_space_m</item>
        <item name="android:paddingRight">@dimen/eh_space_m</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Enginehost.Button.Secondary">
        <item name="android:background">@drawable/eh_btn_secondary_bg</item>
        <item name="android:textColor">@color/eh_button_secondary_text</item>
    </style>

    <style name="Widget.Enginehost.Button.Danger">
        <item name="android:background">@drawable/eh_btn_secondary_bg</item>
        <item name="android:textColor">@color/eh_danger</item>
    </style>

    <style name="Widget.Enginehost.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/eh_edittext_bg</item>
        <item name="android:textColor">@color/eh_text_primary</item>
        <item name="android:textColorHint">@color/eh_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/eh_touch_target</item>
        <item name="android:paddingLeft">@dimen/eh_space_m</item>
        <item name="android:paddingRight">@dimen/eh_space_m</item>
        <item name="android:paddingTop">@dimen/eh_space_s</item>
        <item name="android:paddingBottom">@dimen/eh_space_s</item>
    </style>

    <style name="Widget.Enginehost.Card" parent="">
        <item name="android:background">@drawable/eh_card_bg</item>
        <item name="android:paddingLeft">@dimen/eh_card_padding_h</item>
        <item name="android:paddingRight">@dimen/eh_card_padding_h</item>
        <item name="android:paddingTop">@dimen/eh_card_padding_v</item>
        <item name="android:paddingBottom">@dimen/eh_card_padding_v</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.Enginehost.Card.Focusable">
        <item name="android:background">@drawable/eh_card_focusable_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!--
        The Ultimate warning. Deliberately outside the density tokens: it keeps
        full padding in landscape while everything around it tightens, because
        the label alone no longer says the build is unfinished, so this sentence
        is the only thing carrying "verified origin, still not for use".
    -->
    <style name="Widget.Enginehost.Warning" parent="">
        <item name="android:background">@drawable/eh_warning_bg</item>
        <item name="android:padding">@dimen/eh_space_m</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/eh_on_caution_container</item>
    </style>

    <style name="Widget.Enginehost.Badge" parent="">
        <item name="android:background">@drawable/eh_badge_bg</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

</resources>
