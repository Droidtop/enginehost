<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Native interpreters operate on complete game directory trees in place. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app self-update: opening a PackageInstaller session for our own
         APK needs the install-unknown-apps grant; the second permission lets
         Android 12+ skip the confirmation dialog only when the system itself
         judges Enginehost eligible (its own installer of record). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".EnginehostApplication"
        android:appComponentFactory=".EnginehostComponentFactory"
        tools:replace="android:appComponentFactory"
        android:label="@string/app_name"
        android:theme="@style/Theme.Enginehost"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <!-- Configuration UI and lightweight direct-use game library. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ControllerConfigActivity"
            android:exported="false" />

        <activity
            android:name=".EnginehostSettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.enginehost.CONFIGURE_SAVES" />
                <action android:name="dev.enginehost.CONFIGURE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameScanActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.enginehost.SCAN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigEditorActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.enginehost.CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".CapabilityProvider"
            android:authorities="dev.enginehost.capabilities"
            android:exported="true"
            android:grantUriPermissions="false" />

        <activity
            android:name=".ProblemReportActivity"
            android:exported="false"
            android:label="@string/report_title" />

        <activity
            android:name=".ProblemReportFormActivity"
            android:exported="false"
            android:label="@string/report_form_title" />

        <activity
            android:name=".PluginTrustActivity"
            android:exported="false" />

        <!-- PackageInstaller reports the self-update verdict here. -->
        <receiver
            android:name=".AppUpdateStatusReceiver"
            android:exported="false" />

        <activity
            android:name=".PluginCatalogActivity"
            android:exported="false" />

        <activity
            android:name=".RuntimeActivity"
            android:exported="false"
            android:process=":runtime"
            android:theme="@style/Theme.Enginehost.Runtime"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Instantiated as a signed bundle's Activity by EnginehostComponentFactory. -->
        <activity
            android:name=".BundledActivityProxy"
            android:exported="false"
            android:process=":runtime"
            android:theme="@style/Theme.Enginehost.Runtime"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
             The only real entry point, and deliberately the whole
             contract: exported, takes one extra ("path", an absolute
             folder), and figures out everything else, which engine,
             which file to run, engine-specific options, from an
             enginehost.json file this app expects to find at that
             folder's own root. No game import step or per-caller metadata
             to keep in sync; any caller (not just droidtop)
             just needs a folder with a valid config in it. An optional
             "title" in the config names the game on the launch screen this
             activity shows until the engine draws. See LaunchActivity and
             EngineConfig's own doc comments.
        -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.Enginehost.Launch"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="dev.enginehost.LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
