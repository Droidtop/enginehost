<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
             Both install activities are adb and CI only, and exist only in
             the debug build. DUMP is held by the shell user and by no app a
             person can install, so `adb shell am start` still reaches this
             while another app on the rig cannot use it to install and
             approve bundles behind the person's back.
        -->
        <activity
            android:name=".DebugBundleInstallActivity"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.enginehost.debug.INSTALL_BUNDLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Install a bundle file already on the device, through the trust screen. See BundleInstallActivity. -->
        <activity
            android:name=".BundleInstallActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="dev.enginehost.INSTALL_BUNDLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
             docs/engine-sandbox.md "Surface handoff" feasibility exerciser:
             can an isolated_app UID composite into a Surface handed to it
             over Binder at all. DUMP-gated like the install activities
             above: adb/CI only, absent from release builds.
        -->
        <activity
            android:name=".DebugSurfaceTestActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":runtime">
            <intent-filter>
                <action android:name="dev.enginehost.debug.SURFACE_TEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".DebugSurfaceTestService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":debug_surface_test" />

    </application>
</manifest>
