{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enginehost.dev/schema/enginehost-release-v1.json",
  "title": "Enginehost GitHub release browsing envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "bundles"],
  "properties": {
    "formatVersion": { "const": 1 },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifestBase64", "signatureBase64"],
        "properties": {
          "manifestBase64": { "type": "string", "contentEncoding": "base64" },
          "signatureBase64": { "type": "string", "contentEncoding": "base64" }
        }
      }
    }
  }
}
