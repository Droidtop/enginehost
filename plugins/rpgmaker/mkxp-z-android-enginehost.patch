diff --git a/.github/workflows/enginehost-build.yml b/.github/workflows/enginehost-build.yml
new file mode 100644
index 0000000..a77906a
--- /dev/null
+++ b/.github/workflows/enginehost-build.yml
@@ -0,0 +1,35 @@
+name: Build unified enginehost RPG Maker plugin
+
+on:
+  push:
+    branches: [enginehost]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  android:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: 17
+
+      - name: Fetch the Android port's pinned native dependencies
+        working-directory: app/jni
+        run: ./get_deps.sh
+
+      - name: Build the native RGSS and HTML5 plugin APK
+        run: ./gradlew :app:assembleDebug --stacktrace
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: enginehost-plugin-rpgmaker-debug-apks
+          path: app/build/outputs/apk/debug/*.apk
+          if-no-files-found: error
diff --git a/ENGINEHOST.md b/ENGINEHOST.md
new file mode 100644
